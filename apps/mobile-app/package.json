{
  "name": "@showlog/mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "APP_VARIANT=development npx expo start --dev-client",
    "lint": "expo lint app components hooks utils constants types",
    "lint:fix": "expo lint app components hooks utils constants types --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests --forceExit",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests --forceExit",
    "test:coverage": "jest --coverage --watchAll=false --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:ios-simulator": "eas build --platform ios --profile ios-simulator",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:production:ios": "eas build --platform ios --profile production",
    "workflow:preview": "eas workflow:run .eas/workflows/preview.yml",
    "update:preview": "eas update --channel preview",
    "ios": "APP_VARIANT=development expo run:ios",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.22",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.25",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-shimmer-placeholder": "^2.0.9",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "shared": "*",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "maxWorkers": "50%",
    "moduleNameMapper": {
      "^shared/(.*)$": "<rootDir>/../../packages/shared/src/$1",
      "^shared$": "<rootDir>/../../packages/shared/src",
      "^@/(.*)$": "<rootDir>/$1",
      "^@convex/(.*)$": "<rootDir>/../../convex/$1",
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/(.*)$": "<rootDir>/../../node_modules/react/$1",
      "^react-test-renderer$": "<rootDir>/../../node_modules/react-test-renderer",
      "^react-test-renderer/(.*)$": "<rootDir>/../../node_modules/react-test-renderer/$1",
      "^react-native-worklets$": "<rootDir>/../../node_modules/react-native-worklets/src/mock",
      "^@gorhom/bottom-sheet$": "<rootDir>/../../node_modules/@gorhom/bottom-sheet/mock"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|jest-expo|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|@shopify/flash-list|react-native-worklets|convex|@convex-dev/auth|is-network-error))"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/__tests__/**",
      "!**/jest-setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js|jsx)",
      "**/*.(test|spec).(ts|tsx|js|jsx)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.expo/"
    ],
    "coverageReporters": [
      "text",
      "lcovonly"
    ]
  },
  "private": true
}
